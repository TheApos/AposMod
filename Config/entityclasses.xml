<configs>
	<!-- playerFemale extends playerMale, so both genders get these -->
	<!-- Perk scaling uses ProgressionLevel per level (0..5); Ragdoll force/range cannot read cvars -->
	<append xpath="/entity_classes/entity_class[@name='playerMale']">

		<!-- ===== Knives, clubs, sledgehammers: the traits and mastery trees live in Source/AposKnife.cs, AposClub.cs,
		     AposSledge.cs. XML only says whether the swing is a power attack (aposPower, Source/AposMelee.cs). ===== -->
		<effect_group name="AposMod melee events">
			<requirement name="HoldingItemHasTags" tags="melee"/>
			<triggered_effect trigger="onSelfPrimaryActionStart" action="ModifyCVar" cvar="aposPower" operation="set" value="0"/>
			<triggered_effect trigger="onSelfSecondaryActionStart" action="ModifyCVar" cvar="aposPower" operation="set" value="1"/>
		</effect_group>

		<!-- ===== Batons, spears, knuckles: traits and mastery trees in Source/AposBaton.cs, AposSpear.cs, AposKnuckles.cs ===== -->

		<!-- ===== Pistols / SMG: "Headhunter" and the mastery tree live in Source/AposPistol.cs (Weapon Mastery 2.0).
		     XML only reports shots and misses to it: aposPShot / aposPMiss on the player (C# reads and clears them). ===== -->
		<effect_group name="AposMod pistol events">
			<requirement name="HoldingItemHasTags" tags="perkGunslinger"/>
			<triggered_effect trigger="onSelfRangedBurstShotStart" action="ModifyCVar" cvar="aposPShot" operation="add" value="1"/>
			<triggered_effect trigger="onSelfPrimaryActionRayMiss" action="ModifyCVar" cvar="aposPMiss" operation="add" value="1"/>
			<triggered_effect trigger="onSelfPrimaryActionMissEntity" action="ModifyCVar" cvar="aposPMiss" operation="add" value="1"/>
		</effect_group>

		<!-- ===== Shotguns: the mastery tree lives in Source/AposShotgun.cs; XML only reports shots (aposSShot) ===== -->
		<effect_group name="AposMod shotgun events">
			<requirement name="HoldingItemHasTags" tags="perkBoomstick"/>
			<triggered_effect trigger="onSelfRangedBurstShotStart" action="ModifyCVar" cvar="aposSShot" operation="add" value="1"/>
		</effect_group>

		<!-- ===== Rifles: "Ricochet" and the mastery tree live in Source/AposRifle.cs; XML only reports shots (aposRShot) ===== -->
		<effect_group name="AposMod rifle events">
			<requirement name="HoldingItemHasTags" tags="perkDeadEye"/>
			<triggered_effect trigger="onSelfRangedBurstShotStart" action="ModifyCVar" cvar="aposRShot" operation="add" value="1"/>
		</effect_group>

		<!-- ===== Machine guns: "Suppression" and the mastery tree live in Source/AposMG.cs; XML only reports shots (aposMShot) ===== -->
		<effect_group name="AposMod mg events">
			<requirement name="HoldingItemHasTags" tags="perkMachineGunner"/>
			<triggered_effect trigger="onSelfRangedBurstShotStart" action="ModifyCVar" cvar="aposMShot" operation="add" value="1"/>
		</effect_group>

		<!-- ===== Crossbows: "Mark" - your damage (any weapon) to a marked zombie: +aposMarkBonus (crossbow mastery tree,
		     Source/AposCrossbow.cs sets it: 20% base, Deep Mark 35/50/80%, x2 with Hunting Party). The mark is put by the C# part. ===== -->
		<effect_group name="AposMod crossbow mark bonus">
			<requirement name="CVarCompare" cvar="aposMarked" operation="Equals" value="1" target="other"/>
			<passive_effect name="EntityDamage" operation="perc_add" value="@aposMarkBonus"/>
		</effect_group>

		<!-- ===== Robots: "Guardian Protocol" — scales with Robotics Inventor (perkTurrets) ===== -->
		<!-- While your health is below 50% (70% at level 5) your deployed turrets and robotic sledges attack
		     30% faster + 10% per level and deal 10% + 5% per level more damage. Turret attacks read the owner's
		     passives by item tags (vanilla perkTurrets works the same way).
		     The health check sits on each passive: a group-level one runs for every passive lookup, also while a
		     joining multiplayer player's stats are created (Health is still null there -> NullReferenceException). -->
		<effect_group name="AposMod robots guardian">
			<requirement name="ProgressionLevel" progression_name="perkTurrets" operation="LT" value="5"/>
			<passive_effect name="RoundsPerMinute" operation="perc_add" value=".3" tags="turretRanged,turretMelee"><requirement name="StatComparePercCurrentToMax" stat="Health" operation="LT" value=".5"/><requirement name="ProgressionLevel" progression_name="perkTurrets" operation="Equals" value="0"/></passive_effect>
			<passive_effect name="RoundsPerMinute" operation="perc_add" value=".4" tags="turretRanged,turretMelee"><requirement name="StatComparePercCurrentToMax" stat="Health" operation="LT" value=".5"/><requirement name="ProgressionLevel" progression_name="perkTurrets" operation="Equals" value="1"/></passive_effect>
			<passive_effect name="RoundsPerMinute" operation="perc_add" value=".5" tags="turretRanged,turretMelee"><requirement name="StatComparePercCurrentToMax" stat="Health" operation="LT" value=".5"/><requirement name="ProgressionLevel" progression_name="perkTurrets" operation="Equals" value="2"/></passive_effect>
			<passive_effect name="RoundsPerMinute" operation="perc_add" value=".6" tags="turretRanged,turretMelee"><requirement name="StatComparePercCurrentToMax" stat="Health" operation="LT" value=".5"/><requirement name="ProgressionLevel" progression_name="perkTurrets" operation="Equals" value="3"/></passive_effect>
			<passive_effect name="RoundsPerMinute" operation="perc_add" value=".7" tags="turretRanged,turretMelee"><requirement name="StatComparePercCurrentToMax" stat="Health" operation="LT" value=".5"/><requirement name="ProgressionLevel" progression_name="perkTurrets" operation="Equals" value="4"/></passive_effect>
			<passive_effect name="EntityDamage" operation="perc_add" value=".1" tags="perkTurrets"><requirement name="StatComparePercCurrentToMax" stat="Health" operation="LT" value=".5"/><requirement name="ProgressionLevel" progression_name="perkTurrets" operation="Equals" value="0"/></passive_effect>
			<passive_effect name="EntityDamage" operation="perc_add" value=".15" tags="perkTurrets"><requirement name="StatComparePercCurrentToMax" stat="Health" operation="LT" value=".5"/><requirement name="ProgressionLevel" progression_name="perkTurrets" operation="Equals" value="1"/></passive_effect>
			<passive_effect name="EntityDamage" operation="perc_add" value=".2" tags="perkTurrets"><requirement name="StatComparePercCurrentToMax" stat="Health" operation="LT" value=".5"/><requirement name="ProgressionLevel" progression_name="perkTurrets" operation="Equals" value="2"/></passive_effect>
			<passive_effect name="EntityDamage" operation="perc_add" value=".25" tags="perkTurrets"><requirement name="StatComparePercCurrentToMax" stat="Health" operation="LT" value=".5"/><requirement name="ProgressionLevel" progression_name="perkTurrets" operation="Equals" value="3"/></passive_effect>
			<passive_effect name="EntityDamage" operation="perc_add" value=".3" tags="perkTurrets"><requirement name="StatComparePercCurrentToMax" stat="Health" operation="LT" value=".5"/><requirement name="ProgressionLevel" progression_name="perkTurrets" operation="Equals" value="4"/></passive_effect>
		</effect_group>
		<!-- Robotics Inventor 5: kicks in below 70% health, +80% speed and +35% damage -->
		<effect_group name="AposMod robots guardian 5">
			<requirement name="ProgressionLevel" progression_name="perkTurrets" operation="Equals" value="5"/>
			<passive_effect name="RoundsPerMinute" operation="perc_add" value=".8" tags="turretRanged,turretMelee"><requirement name="StatComparePercCurrentToMax" stat="Health" operation="LT" value=".7"/></passive_effect>
			<passive_effect name="EntityDamage" operation="perc_add" value=".35" tags="perkTurrets"><requirement name="StatComparePercCurrentToMax" stat="Health" operation="LT" value=".7"/></passive_effect>
		</effect_group>

		<!-- ===== Pipe weapons (T0): "Veteran Junk" — +2% damage per kill, max +1000% ===== -->
		<!-- aposPipeBonus = shown bonus in % (0..1000), aposPipeMult = the same as a fraction for perc_add -->
		<effect_group name="AposMod pipe veteran">
			<triggered_effect trigger="onSelfKilledOther" action="ModifyCVar" cvar="aposPipeBonus" operation="add" value="2">
				<requirement name="HoldingItemHasTags" tags="aposPipe"/>
				<requirement name="CVarCompare" cvar="aposPipeBonus" operation="LT" value="1000"/>
			</triggered_effect>
			<triggered_effect trigger="onSelfKilledOther" action="ShowToolbeltMessage" message_key="aposPipeMaxed">
				<requirement name="HoldingItemHasTags" tags="aposPipe"/>
				<requirement name="CVarCompare" cvar="aposPipeBonus" operation="Equals" value="1000"/>
				<requirement name="!HasBuff" buff="buffAposPipeMaxShown"/>
			</triggered_effect>
			<triggered_effect trigger="onSelfKilledOther" action="AddBuff" buff="buffAposPipeMaxShown">
				<requirement name="CVarCompare" cvar="aposPipeBonus" operation="GTE" value="1000"/>
			</triggered_effect>
			<!-- recompute the multiplier on kills and on login (old saves keep their bonus) -->
			<triggered_effect trigger="onSelfKilledOther" action="ModifyCVar" cvar="aposPipeMult" operation="set" value="@aposPipeBonus"/>
			<triggered_effect trigger="onSelfKilledOther" action="ModifyCVar" cvar="aposPipeMult" operation="divide" value="100"/>
			<triggered_effect trigger="onSelfEnteredGame" action="ModifyCVar" cvar="aposPipeMult" operation="set" value="@aposPipeBonus"/>
			<triggered_effect trigger="onSelfEnteredGame" action="ModifyCVar" cvar="aposPipeMult" operation="divide" value="100"/>
		</effect_group>
		<effect_group name="AposMod pipe veteran damage">
			<requirement name="HoldingItemHasTags" tags="aposPipe"/>
			<passive_effect name="EntityDamage" operation="perc_add" value="@aposPipeMult"/>
		</effect_group>	</append>
</configs>
