<configs>
	<!-- ===== Molotov: burning zombies move much slower ===== -->
	<append xpath="/buffs/buff[@name='buffBurningMolotov']">
		<effect_group name="AposMod molotov slow">
			<requirement name="!EntityTagCompare" tags="player"/>
			<passive_effect name="WalkSpeed" operation="perc_add" value="-.7"/>
			<passive_effect name="RunSpeed" operation="perc_add" value="-.7"/>
		</effect_group>
	</append>

	<!-- ===== Veteran Junk indicator: shown while a pipe weapon is in hand ===== -->
	<!-- buffStatusCheck01 is always on the player and updates every 2 s -->
	<append xpath="/buffs/buff[@name='buffStatusCheck01']">
		<!-- Guardian Protocol indicator: shown to robot users (Robotics Inventor 1+) while their health is low -->
		<effect_group name="AposMod robots guardian indicator">
			<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buffAposGuardian">
				<requirement name="ProgressionLevel" progression_name="perkTurrets" operation="GTE" value="1"/>
				<requirement name="StatComparePercCurrentToMax" stat="Health" operation="LT" value=".3"/>
				<requirement name="!HasBuff" buff="buffAposGuardian"/>
			</triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buffAposGuardian">
				<requirement name="ProgressionLevel" progression_name="perkTurrets" operation="Equals" value="5"/>
				<requirement name="StatComparePercCurrentToMax" stat="Health" operation="LT" value=".5"/>
				<requirement name="!HasBuff" buff="buffAposGuardian"/>
			</triggered_effect>
		</effect_group>
		<!-- Energy Shield: count down the recharge timer (every 2 s) and raise the shield when it is over -->
		<effect_group name="AposMod energy shield recharge">
			<requirement name="CVarCompare" cvar="aposShieldWorn" operation="Equals" value="1"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposShieldDown" operation="add" value="-2">
				<requirement name="CVarCompare" cvar="aposShieldDown" operation="GT" value="0"/>
			</triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buffAposShieldUp">
				<requirement name="CVarCompare" cvar="aposShieldDown" operation="LTE" value="0"/>
				<requirement name="!HasBuff" buff="buffAposShieldUp"/>
			</triggered_effect>
		</effect_group>
		<effect_group name="AposMod pipe veteran indicator">
			<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buffAposPipeVeteran">
				<requirement name="HoldingItemHasTags" tags="aposPipe"/>
				<requirement name="!HasBuff" buff="buffAposPipeVeteran"/>
			</triggered_effect>
		</effect_group>
	</append>

	<append xpath="/buffs">
		<!-- Knife: regenerates aposKnifeStacks HP/s; every knife hit resets aposKnifeTime to 5 s
		     (same timer pattern as vanilla bleeding, so re-adding never resets the stacks) -->
		<buff name="buffAposKnifeRegen" name_key="buffAposKnifeRegenName" description_key="buffAposKnifeRegenDesc" icon="ui_game_symbol_laceration" icon_color="200,30,30">
			<stack_type value="ignore"/>
			<display_value value="aposKnifeStacks"/>
			<effect_group>
				<passive_effect name="HealthChangeOT" operation="base_add" value="@aposKnifeStacks"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposKnifeTime" operation="add" value="-1"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposKnifeRegen">
					<requirement name="CVarCompare" cvar="aposKnifeTime" operation="LTE" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="aposKnifeStacks" operation="set" value="0"/>
			</effect_group>
		</buff>

		<!-- Knuckles: shown while there are counter charges; the number = charges left -->
		<buff name="buffAposCounter" name_key="buffAposCounterName" description_key="buffAposCounterDesc" icon="ui_game_symbol_boxer" icon_color="255,180,0">
			<stack_type value="ignore"/>
			<display_value value="aposCounterHits"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposCounter">
					<requirement name="CVarCompare" cvar="aposCounterHits" operation="LTE" value="0"/>
				</triggered_effect>
			</effect_group>
		</buff>

		<!-- Rage (replaces Grand Slam): number = stacks; bonuses only with clubs/sledges in hand -->
		<buff name="buffAposRage" name_key="buffAposRageName" description_key="buffAposRageDesc" icon="ui_game_symbol_berserker" icon_color="255,60,0">
			<stack_type value="ignore"/>
			<display_value value="aposRageStacks"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposRageTime" operation="add" value="-1"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposRage">
					<requirement name="CVarCompare" cvar="aposRageTime" operation="LTE" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="aposRageStacks" operation="set" value="0"/>
			</effect_group>
			<effect_group>
				<requirement name="HoldingItemHasTags" tags="perkPummelPete,perkSkullCrusher"/>
				<passive_effect name="EntityDamage" operation="perc_add" value="@aposRageDamage"/>
				<passive_effect name="AttacksPerMinute" operation="perc_add" value="@aposRageSpeed"/>
			</effect_group>
			<!-- Rage 5 "Rampage": at 5 stacks club/sledge attacks cost no stamina and you cannot be stunned or knocked down -->
			<effect_group>
				<requirement name="HoldingItemHasTags" tags="perkPummelPete,perkSkullCrusher"/>
				<requirement name="CVarCompare" cvar="aposRageStacks" operation="GTE" value="5"/>
				<passive_effect name="StaminaLoss" operation="perc_add" value="-1"/>
				<passive_effect name="BuffResistance" operation="base_set" value="100" tags="buffInjuryStunned01,buffInjuryStunned02,buffInjuryStunned03,buffInjuryKnockdown01,buffInjuryKnockdown02"/>
			</effect_group>
		</buff>

		<!-- Earthquake damage (Skull Crusher): each knocked-down target loses its own aposQuakeDmg (negative) HP -->
		<buff name="buffAposQuakeHit" hidden="true">
			<stack_type value="replace"/>
			<duration value="1"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyStats" stat="Health" operation="add" value="@aposQuakeDmg"/>
			</effect_group>
		</buff>

		<!-- ===== Ranged pack ===== -->

		<!-- Pistols "Headhunter": number = empowered shots left. Damage bonus aposHHDamage is set on activation. -->
		<buff name="buffAposHeadhunter" name_key="buffAposHeadhunterName" description_key="buffAposHeadhunterDesc" icon="ui_game_symbol_head_shot" icon_color="0,220,255">
			<stack_type value="ignore"/>
			<display_value value="aposHHShots"/>
			<effect_group>
				<requirement name="HoldingItemHasTags" tags="handgunSkill"/>
				<passive_effect name="EntityDamage" operation="perc_add" value="@aposHHDamage"/>
				<passive_effect name="SpreadDegreesVertical" operation="perc_add" value="-.9"/>
				<passive_effect name="SpreadDegreesHorizontal" operation="perc_add" value="-.9"/>
			</effect_group>
			<effect_group>
				<!-- the shot after the last empowered one removes the buff (see entityclasses.xml) -->
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposHeadhunter">
					<requirement name="CVarCompare" cvar="aposHHShots" operation="LT" value="0"/>
				</triggered_effect>
			</effect_group>
		</buff>

		<!-- Machine guns "Thrifty": the next shot or two cost no ammo -->
		<buff name="buffAposThrifty" hidden="true">
			<stack_type value="replace"/>
			<duration value=".2"/>
			<effect_group>
				<passive_effect name="InfiniteAmmo" operation="base_set" value="1"/>
			</effect_group>
		</buff>

		<!-- Machine guns "Suppression" (on the zombie): aposSupStacks hits, -5% speed each, capped at aposSupMax (negative).
		     aposSupFull = 1 at the cap (Machine Gunner 5 deals +25% to such targets). Every hit resets aposSupTime to 8 s. -->
		<buff name="buffAposSuppressed" hidden="true">
			<stack_type value="ignore"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposSupSlow" operation="set" value="@aposSupStacks"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposSupSlow" operation="multiply" value="-.05"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposSupFull" operation="set" value="0"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposSupFull" operation="set" value="1">
					<requirement name="CVarCompare" cvar="aposSupSlow" operation="LTE" value="@aposSupMax"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposSupSlow" operation="set" value="@aposSupMax">
					<requirement name="CVarCompare" cvar="aposSupSlow" operation="LT" value="@aposSupMax"/>
				</triggered_effect>
				<passive_effect name="WalkSpeed" operation="perc_add" value="@aposSupSlow"/>
				<passive_effect name="RunSpeed" operation="perc_add" value="@aposSupSlow"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposSupTime" operation="add" value="-1"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposSuppressed">
					<requirement name="CVarCompare" cvar="aposSupTime" operation="LTE" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="RemoveCVar" cvar="aposSupStacks,aposSupSlow,aposSupFull,aposSupTime"/>
			</effect_group>
		</buff>

		<!-- Crossbows "Mark" (on the zombie): aposMarked = 1 while marked; your damage to it is raised in entityclasses.xml -->
		<buff name="buffAposMark" hidden="true">
			<stack_type value="ignore"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="aposMarked" operation="set" value="1"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposMarkTime" operation="add" value="-1"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposMark">
					<requirement name="CVarCompare" cvar="aposMarkTime" operation="LTE" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="RemoveCVar" cvar="aposMarked,aposMarkTime"/>
			</effect_group>
		</buff>

		<!-- Area damage for Ricochet (rifles) and Splinter (bows): the target loses its own aposSplashDmg (negative) HP.
		     stack_type ignore + short duration: a second application in the same moment does nothing. -->
		<buff name="buffAposSplash" hidden="true">
			<stack_type value="ignore"/>
			<duration value=".3"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyStats" stat="Health" operation="add" value="@aposSplashDmg"/>
			</effect_group>
		</buff>

		<!-- Robots "Guardian Protocol": display only; the bonus itself lives in entityclasses.xml -->
		<buff name="buffAposGuardian" name_key="buffAposGuardianName" description_key="buffAposGuardianDesc" icon="ui_game_symbol_electric_turret" icon_color="0,220,255">
			<stack_type value="ignore"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposGuardian">
					<requirement name="StatComparePercCurrentToMax" stat="Health" operation="GTE" value=".3"/>
					<requirement name="ProgressionLevel" progression_name="perkTurrets" operation="LT" value="5"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposGuardian">
					<requirement name="StatComparePercCurrentToMax" stat="Health" operation="GTE" value=".5"/>
				</triggered_effect>
			</effect_group>
		</buff>

		<!-- Energy Shield charged: ranged attacks deal no damage -->
		<buff name="buffAposShieldUp" name_key="buffAposShieldUpName" description_key="buffAposShieldUpDesc" icon="ui_game_symbol_defense" icon_color="0,200,255">
			<stack_type value="ignore"/>
			<effect_group>
				<passive_effect name="PhysicalDamageResist" operation="base_add" value="100" tags="ranged"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposShieldUp">
					<requirement name="CVarCompare" cvar="aposShieldWorn" operation="NotEquals" value="1"/>
				</triggered_effect>
			</effect_group>
		</buff>

		<!-- Anti-spam cooldowns for crowd control (visible, with timer) -->
		<buff name="buffAposQuakeCD" name_key="buffAposQuakeCDName" description_key="buffAposQuakeCDDesc" icon="ui_game_symbol_sledge" icon_color="150,150,150">
			<stack_type value="ignore"/>
			<duration value="4"/>
		</buff>
		<buff name="buffAposChainCD" name_key="buffAposChainCDName" description_key="buffAposChainCDDesc" icon="ui_game_symbol_electric_power" icon_color="150,150,150">
			<stack_type value="ignore"/>
			<duration value="3"/>
		</buff>

		<!-- Pipe weapons: marks that the "max bonus" message was shown once -->
		<buff name="buffAposPipeMaxShown" hidden="true" remove_on_death="false">
			<stack_type value="ignore"/>
		</buff>

		<!-- Pipe weapons: the number shows the current damage bonus in % -->
		<buff name="buffAposPipeVeteran" name_key="buffAposPipeVeteranName" description_key="buffAposPipeVeteranDesc" icon="ui_game_symbol_pistol" icon_color="255,180,0" remove_on_death="false">
			<stack_type value="ignore"/>
			<display_value value="aposPipeBonus"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposPipeVeteran">
					<requirement name="!HoldingItemHasTags" tags="aposPipe"/>
				</triggered_effect>
			</effect_group>
		</buff>
	</append>
</configs>
