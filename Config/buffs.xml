<configs>
	<!-- ===== Molotov: burning zombies move much slower ===== -->
	<append xpath="/buffs/buff[@name='buffBurningMolotov']">
		<effect_group name="AposMod molotov slow">
			<requirement name="!EntityTagCompare" tags="player"/>
			<passive_effect name="WalkSpeed" operation="perc_add" value="-.7"/>
			<passive_effect name="RunSpeed" operation="perc_add" value="-.7"/>
		</effect_group>
		<!-- Molotov fire also burns 4% of the zombie's max health per second (at least 15): every buff update (1 s)
		     asks Source/AposSplinter.cs for one tick, which knows the max health -->
		<effect_group name="AposMod molotov burn">
			<requirement name="!EntityTagCompare" tags="player"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposMolotovTicks" operation="add" value="1"/>
		</effect_group>
	</append>

	<!-- ===== Veteran Junk indicator: shown while a pipe weapon is in hand ===== -->
	<!-- buffStatusCheck01 is always on the player and updates every 2 s -->
	<append xpath="/buffs/buff[@name='buffStatusCheck01']">
		<!-- Guardian Protocol indicator: shown to robot users (Robotics Inventor 1+) while their health is low -->
		<effect_group name="AposMod robots guardian indicator">
			<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buffAposGuardian">
				<requirement name="ProgressionLevel" progression_name="perkTurrets" operation="GTE" value="1"/>
				<requirement name="StatComparePercCurrentToMax" stat="Health" operation="LT" value=".3"/>
				<requirement name="!HasBuff" buff="buffAposGuardian"/>
			</triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buffAposGuardian">
				<requirement name="ProgressionLevel" progression_name="perkTurrets" operation="Equals" value="5"/>
				<requirement name="StatComparePercCurrentToMax" stat="Health" operation="LT" value=".5"/>
				<requirement name="!HasBuff" buff="buffAposGuardian"/>
			</triggered_effect>
		</effect_group>
		<!-- Energy Shield: count down the recharge timer (every 2 s) and raise the shield when it is over -->
		<effect_group name="AposMod energy shield recharge">
			<requirement name="CVarCompare" cvar="aposShieldWorn" operation="Equals" value="1"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposShieldDown" operation="add" value="-2">
				<requirement name="CVarCompare" cvar="aposShieldDown" operation="GT" value="0"/>
			</triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buffAposShieldUp">
				<requirement name="CVarCompare" cvar="aposShieldDown" operation="LTE" value="0"/>
				<requirement name="!HasBuff" buff="buffAposShieldUp"/>
			</triggered_effect>
		</effect_group>
		<effect_group name="AposMod pipe veteran indicator">
			<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buffAposPipeVeteran">
				<requirement name="HoldingItemHasTags" tags="aposPipe"/>
				<requirement name="!HasBuff" buff="buffAposPipeVeteran"/>
			</triggered_effect>
		</effect_group>
	</append>

	<!-- ===== Elemental reactions: every element buff asks buffAposElementCheck to look for a combo ===== -->
	<append xpath="/buffs/buff[@name='buffBurningElement' or @name='buffBurningFlamingArrow' or @name='buffBurningMolotov' or @name='buffShocked']">
		<effect_group name="AposMod element check">
			<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffAposElementCheck"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buffAposElementCheck"/>
		</effect_group>
	</append>

	<append xpath="/buffs">
		<!-- ===== Elemental reactions (Gunfire Reborn style) =====
		     fire + acid  = Explosion: 50% of the last hit (min 60) to the target and every zombie within 4 m
		     fire + shock = Confusion: 5 s, -60% speed, -30 physical resist, 1.5 s stun
		     shock + acid = Miasma:    6 s, -20% max health (current health drops with it), bleeding
		     3 s cooldown per target. buffAposReactionHit (short) lets the damage numbers colour reaction damage. -->
		<buff name="buffAposElementCheck" hidden="true">
			<stack_type value="replace"/>
			<duration value=".1"/>
			<effect_group>
				<requirement name="!HasBuff" buff="buffAposReactionCD"/>
				<!-- Explosion -->
				<triggered_effect trigger="onSelfBuffStart" action="Explode" blast_power="0" block_damage="0" block_radius="0" entity_damage="0" entity_radius="0" damage_type="Heat">
					<requirement name="HasBuff" buff="buffBurningElement,buffBurningFlamingArrow,buffBurningMolotov"/>
					<requirement name="HasBuff" buff="buffAposCorroded"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" target="otherAOE" range="4" target_tags="zombie,animal" buff="buffAposReactionHit">
					<requirement name="HasBuff" buff="buffBurningElement,buffBurningFlamingArrow,buffBurningMolotov"/>
					<requirement name="HasBuff" buff="buffAposCorroded"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffAposReactionHit">
					<requirement name="HasBuff" buff="buffBurningElement,buffBurningFlamingArrow,buffBurningMolotov"/>
					<requirement name="HasBuff" buff="buffAposCorroded"/>
				</triggered_effect>
				<!-- damage: 50% of the last hit (at least 60) here and within 4 m, dealt by Source/AposSplinter.cs -->
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="aposExplodeReq" operation="set" value="1">
					<requirement name="HasBuff" buff="buffBurningElement,buffBurningFlamingArrow,buffBurningMolotov"/>
					<requirement name="HasBuff" buff="buffAposCorroded"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffAposReactionCD">
					<requirement name="HasBuff" buff="buffBurningElement,buffBurningFlamingArrow,buffBurningMolotov"/>
					<requirement name="HasBuff" buff="buffAposCorroded"/>
				</triggered_effect>
				<!-- Confusion -->
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffAposConfused">
					<requirement name="HasBuff" buff="buffBurningElement,buffBurningFlamingArrow,buffBurningMolotov"/>
					<requirement name="HasBuff" buff="buffShocked"/>
					<requirement name="!HasBuff" buff="buffAposReactionCD"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffAposReactionCD">
					<requirement name="HasBuff" buff="buffBurningElement,buffBurningFlamingArrow,buffBurningMolotov"/>
					<requirement name="HasBuff" buff="buffShocked"/>
				</triggered_effect>
				<!-- Miasma -->
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffAposMiasma">
					<requirement name="HasBuff" buff="buffShocked"/>
					<requirement name="HasBuff" buff="buffAposCorroded"/>
					<requirement name="!HasBuff" buff="buffAposReactionCD"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffAposReactionCD">
					<requirement name="HasBuff" buff="buffShocked"/>
					<requirement name="HasBuff" buff="buffAposCorroded"/>
				</triggered_effect>
			</effect_group>
		</buff>

		<!-- Legendary Thunderclap: storm charges (number), full at 3 -->
		<buff name="buffAposThunderCharge" name_key="buffAposThunderChargeName" description_key="buffAposThunderChargeDesc" icon="ui_game_symbol_electric_power" icon_color="255,180,0">
			<stack_type value="ignore"/>
			<display_value value="aposThunder"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposThunderCharge">
					<requirement name="CVarCompare" cvar="aposThunder" operation="LTE" value="0"/>
				</triggered_effect>
			</effect_group>
		</buff>

		<!-- Legendary Big Boom: the next rocket costs no ammo -->
		<buff name="buffAposFreeRocket" name_key="buffAposFreeRocketName" description_key="buffAposFreeRocketDesc" icon="ui_game_symbol_destruction2" icon_color="255,180,0">
			<stack_type value="ignore"/>
			<effect_group>
				<passive_effect name="InfiniteAmmo" operation="base_set" value="1"/>
			</effect_group>
		</buff>

		<buff name="buffAposReactionCD" hidden="true">
			<stack_type value="ignore"/>
			<duration value="3"/>
		</buff>

		<!-- marks reaction damage for the damage numbers (Source/AposMod.cs) -->
		<buff name="buffAposReactionHit" hidden="true">
			<stack_type value="replace"/>
			<duration value=".6"/>
		</buff>

		<buff name="buffAposConfused" hidden="true">
			<stack_type value="replace"/>
			<duration value="5"/>
			<effect_group>
				<passive_effect name="WalkSpeed" operation="perc_add" value="-.6"/>
				<passive_effect name="RunSpeed" operation="perc_add" value="-.6"/>
				<passive_effect name="PhysicalDamageResist" operation="base_add" value="-30"/>
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffInjuryStunned01" duration="1.5"/>
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffAposReactionHit"/>
			</effect_group>
		</buff>

		<buff name="buffAposMiasma" hidden="true">
			<stack_type value="replace"/>
			<duration value="6"/>
			<effect_group>
				<passive_effect name="HealthMax" operation="perc_add" value="-.2"/>
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffInjuryBleeding"/>
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffAposReactionHit"/>
			</effect_group>
		</buff>

		<!-- Knife: regenerates aposKnifeStacks HP/s; every knife hit resets aposKnifeTime to 5 s
		     (same timer pattern as vanilla bleeding, so re-adding never resets the stacks) -->
		<buff name="buffAposKnifeRegen" name_key="buffAposKnifeRegenName" description_key="buffAposKnifeRegenDesc" icon="ui_game_symbol_laceration" icon_color="200,30,30">
			<stack_type value="ignore"/>
			<display_value value="aposKnifeStacks"/>
			<effect_group>
				<passive_effect name="HealthChangeOT" operation="base_add" value="@aposKnifeStacks"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposKnifeTime" operation="add" value="-1"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposKnifeRegen">
					<requirement name="CVarCompare" cvar="aposKnifeTime" operation="LTE" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="aposKnifeStacks" operation="set" value="0"/>
			</effect_group>
		</buff>

		<!-- Knuckles: shown while there are counter charges; the number = charges left -->
		<buff name="buffAposCounter" name_key="buffAposCounterName" description_key="buffAposCounterDesc" icon="ui_game_symbol_boxer" icon_color="255,180,0">
			<stack_type value="ignore"/>
			<display_value value="aposCounterHits"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposCounter">
					<requirement name="CVarCompare" cvar="aposCounterHits" operation="LTE" value="0"/>
				</triggered_effect>
			</effect_group>
		</buff>

		<!-- Rage (replaces Grand Slam): number = stacks; bonuses only with clubs/sledges in hand -->
		<buff name="buffAposRage" name_key="buffAposRageName" description_key="buffAposRageDesc" icon="ui_game_symbol_berserker" icon_color="255,60,0">
			<stack_type value="ignore"/>
			<display_value value="aposRageStacks"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposRageTime" operation="add" value="-1"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposRage">
					<requirement name="CVarCompare" cvar="aposRageTime" operation="LTE" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="aposRageStacks" operation="set" value="0"/>
			</effect_group>
			<effect_group>
				<requirement name="HoldingItemHasTags" tags="perkPummelPete,perkSkullCrusher"/>
				<passive_effect name="EntityDamage" operation="perc_add" value="@aposRageDamage"/>
				<passive_effect name="AttacksPerMinute" operation="perc_add" value="@aposRageSpeed"/>
			</effect_group>
			<!-- Rage 5 "Rampage": at 5 stacks club/sledge attacks cost no stamina and you cannot be stunned or knocked down -->
			<effect_group>
				<requirement name="HoldingItemHasTags" tags="perkPummelPete,perkSkullCrusher"/>
				<requirement name="CVarCompare" cvar="aposRageStacks" operation="GTE" value="5"/>
				<passive_effect name="StaminaLoss" operation="perc_add" value="-1"/>
				<passive_effect name="BuffResistance" operation="base_set" value="100" tags="buffInjuryStunned01,buffInjuryStunned02,buffInjuryStunned03,buffInjuryKnockdown01,buffInjuryKnockdown02"/>
			</effect_group>
		</buff>

		<!-- Earthquake damage (Skull Crusher): each knocked-down target loses its own aposQuakeDmg (negative) HP -->
		<buff name="buffAposQuakeHit" hidden="true">
			<stack_type value="replace"/>
			<duration value="1"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyStats" stat="Health" operation="add" value="@aposQuakeDmg"/>
			</effect_group>
		</buff>

		<!-- ===== Ranged pack ===== -->

		<!-- Pistols "Headhunter": number = empowered shots left. Damage bonus aposHHDamage is set on activation. -->
		<buff name="buffAposHeadhunter" name_key="buffAposHeadhunterName" description_key="buffAposHeadhunterDesc" icon="ui_game_symbol_head_shot" icon_color="0,220,255">
			<stack_type value="ignore"/>
			<display_value value="aposHHShots"/>
			<effect_group>
				<requirement name="HoldingItemHasTags" tags="handgunSkill"/>
				<passive_effect name="EntityDamage" operation="perc_add" value="@aposHHDamage"/>
				<passive_effect name="SpreadDegreesVertical" operation="perc_add" value="-.9"/>
				<passive_effect name="SpreadDegreesHorizontal" operation="perc_add" value="-.9"/>
			</effect_group>
			<effect_group>
				<!-- the shot after the last empowered one removes the buff (see entityclasses.xml) -->
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposHeadhunter">
					<requirement name="CVarCompare" cvar="aposHHShots" operation="LT" value="0"/>
				</triggered_effect>
			</effect_group>
		</buff>

		<!-- Machine guns "Thrifty": the next shot or two cost no ammo -->
		<buff name="buffAposThrifty" hidden="true">
			<stack_type value="replace"/>
			<duration value=".2"/>
			<effect_group>
				<passive_effect name="InfiniteAmmo" operation="base_set" value="1"/>
			</effect_group>
		</buff>

		<!-- Machine guns "Suppression" (on the zombie): aposSupStacks hits, -5% speed each, capped at aposSupMax (negative).
		     aposSupFull = 1 at the cap (Machine Gunner 5 deals +25% to such targets). Every hit resets aposSupTime to 8 s. -->
		<buff name="buffAposSuppressed" hidden="true">
			<stack_type value="ignore"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposSupSlow" operation="set" value="@aposSupStacks"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposSupSlow" operation="multiply" value="-.05"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposSupFull" operation="set" value="0"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposSupFull" operation="set" value="1">
					<requirement name="CVarCompare" cvar="aposSupSlow" operation="LTE" value="@aposSupMax"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposSupSlow" operation="set" value="@aposSupMax">
					<requirement name="CVarCompare" cvar="aposSupSlow" operation="LT" value="@aposSupMax"/>
				</triggered_effect>
				<passive_effect name="WalkSpeed" operation="perc_add" value="@aposSupSlow"/>
				<passive_effect name="RunSpeed" operation="perc_add" value="@aposSupSlow"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposSupTime" operation="add" value="-1"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposSuppressed">
					<requirement name="CVarCompare" cvar="aposSupTime" operation="LTE" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="RemoveCVar" cvar="aposSupStacks,aposSupSlow,aposSupFull,aposSupTime"/>
			</effect_group>
		</buff>

		<!-- Crossbows "Mark" (on the zombie): aposMarked = 1 while marked; your damage to it is raised in entityclasses.xml -->
		<buff name="buffAposMark" hidden="true">
			<stack_type value="ignore"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="aposMarked" operation="set" value="1"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposMarkTime" operation="add" value="-1"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposMark">
					<requirement name="CVarCompare" cvar="aposMarkTime" operation="LTE" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="RemoveCVar" cvar="aposMarked,aposMarkTime"/>
			</effect_group>
		</buff>

		<!-- Crossbow Pin (on the zombie, added by Source/AposPin.cs when a wall is right behind it): cannot move.
		     Regular zombies stay pinned until they die, elites for 10 s. -->
		<buff name="buffAposPinned" hidden="true">
			<stack_type value="ignore"/>
			<effect_group>
				<passive_effect name="WalkSpeed" operation="perc_add" value="-1"/>
				<passive_effect name="RunSpeed" operation="perc_add" value="-1"/>
			</effect_group>
		</buff>
		<buff name="buffAposPinnedElite" hidden="true">
			<stack_type value="replace"/>
			<duration value="10"/>
			<effect_group>
				<passive_effect name="WalkSpeed" operation="perc_add" value="-1"/>
				<passive_effect name="RunSpeed" operation="perc_add" value="-1"/>
			</effect_group>
		</buff>
		<!-- Area damage for Ricochet (rifles) and Splinter (bows): the target loses its own aposSplashDmg (negative) HP.
		     stack_type ignore + short duration: a second application in the same moment does nothing. -->
		<buff name="buffAposSplash" hidden="true">
			<stack_type value="ignore"/>
			<duration value=".3"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyStats" stat="Health" operation="add" value="@aposSplashDmg"/>
			</effect_group>
		</buff>

		<!-- Robots "Guardian Protocol": display only; the bonus itself lives in entityclasses.xml -->
		<buff name="buffAposGuardian" name_key="buffAposGuardianName" description_key="buffAposGuardianDesc" icon="ui_game_symbol_electric_turret" icon_color="0,220,255">
			<stack_type value="ignore"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposGuardian">
					<requirement name="StatComparePercCurrentToMax" stat="Health" operation="GTE" value=".3"/>
					<requirement name="ProgressionLevel" progression_name="perkTurrets" operation="LT" value="5"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposGuardian">
					<requirement name="StatComparePercCurrentToMax" stat="Health" operation="GTE" value=".5"/>
				</triggered_effect>
			</effect_group>
		</buff>

		<!-- Acid mod (on the zombie): -25% physical resistance for 6 s (aposCorrodeTime, refreshed by acid hits);
		     the damage per second scales with your last hit (acid scaling group below) -->
		<buff name="buffAposCorroded" hidden="true">
			<stack_type value="ignore"/>
			<effect_group>
				<passive_effect name="PhysicalDamageResist" operation="base_add" value="-25"/>
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffAposElementCheck"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buffAposElementCheck"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposCorrodeTime" operation="add" value="-1"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposCorroded">
					<requirement name="CVarCompare" cvar="aposCorrodeTime" operation="LTE" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="RemoveCVar" cvar="aposCorrodeTime"/>
			</effect_group>
		</buff>

		<!-- Energy Shield charged: ranged attacks deal no damage -->
		<buff name="buffAposShieldUp" name_key="buffAposShieldUpName" description_key="buffAposShieldUpDesc" icon="ui_game_symbol_defense" icon_color="0,200,255">
			<stack_type value="ignore"/>
			<effect_group>
				<passive_effect name="PhysicalDamageResist" operation="base_add" value="100" tags="ranged"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposShieldUp">
					<requirement name="CVarCompare" cvar="aposShieldWorn" operation="NotEquals" value="1"/>
				</triggered_effect>
			</effect_group>
		</buff>

		<!-- Anti-spam cooldowns for crowd control (visible, with timer) -->
		<buff name="buffAposQuakeCD" name_key="buffAposQuakeCDName" description_key="buffAposQuakeCDDesc" icon="ui_game_symbol_sledge" icon_color="150,150,150">
			<stack_type value="ignore"/>
			<duration value="4"/>
		</buff>
		<buff name="buffAposChainCD" name_key="buffAposChainCDName" description_key="buffAposChainCDDesc" icon="ui_game_symbol_electric_power" icon_color="150,150,150">
			<stack_type value="ignore"/>
			<duration value="3"/>
		</buff>

		<!-- Pipe weapons: marks that the "max bonus" message was shown once -->
		<buff name="buffAposPipeMaxShown" hidden="true" remove_on_death="false">
			<stack_type value="ignore"/>
		</buff>

		<!-- Pipe weapons: the number shows the current damage bonus in % -->
		<buff name="buffAposPipeVeteran" name_key="buffAposPipeVeteranName" description_key="buffAposPipeVeteranDesc" icon="ui_game_symbol_pistol" icon_color="255,180,0" remove_on_death="false">
			<stack_type value="ignore"/>
			<display_value value="aposPipeBonus"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposPipeVeteran">
					<requirement name="!HoldingItemHasTags" tags="aposPipe"/>
				</triggered_effect>
			</effect_group>
		</buff>
	</append>

	<!-- ===================== Elemental damage scales with the weapon =====================
	     Source/AposCombat.cs stores the damage of your last hit on the zombie in aposHitDmg. Every second the element
	     deals a share of it on top of the vanilla tick, never less than a minimum:
	     fire (mod, flaming arrows, legendaries) 10%/s, min 10 · shock 15%/s, min 10 · acid 8%/s, min 8.
	     Only on zombies/animals you have hit (aposHitDmg > 0); players are never affected. -->
	<append xpath="/buffs/buff[@name='buffBurningElement' or @name='buffBurningFlamingArrow']">
		<effect_group name="AposMod fire scaling">
			<requirement name="!EntityTagCompare" tags="player"/>
			<requirement name="CVarCompare" cvar="aposHitDmg" operation="GT" value="0"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposFireTick" operation="set" value="@aposHitDmg"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposFireTick" operation="multiply" value="-.1"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposFireTick" operation="set" value="-10">
				<requirement name="CVarCompare" cvar="aposFireTick" operation="GT" value="-10"/>
			</triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyStats" stat="Health" operation="add" value="@aposFireTick"/>
		</effect_group>
	</append>
	<append xpath="/buffs/buff[@name='buffShocked']">
		<effect_group name="AposMod shock scaling">
			<requirement name="!EntityTagCompare" tags="player"/>
			<requirement name="CVarCompare" cvar="aposHitDmg" operation="GT" value="0"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposShockTick" operation="set" value="@aposHitDmg"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposShockTick" operation="multiply" value="-.15"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposShockTick" operation="set" value="-10">
				<requirement name="CVarCompare" cvar="aposShockTick" operation="GT" value="-10"/>
			</triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyStats" stat="Health" operation="add" value="@aposShockTick"/>
		</effect_group>
	</append>
	<append xpath="/buffs/buff[@name='buffAposCorroded']">
		<effect_group name="AposMod acid scaling">
			<requirement name="CVarCompare" cvar="aposHitDmg" operation="GT" value="0"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposAcidTick" operation="set" value="@aposHitDmg"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposAcidTick" operation="multiply" value="-.08"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposAcidTick" operation="set" value="-8">
				<requirement name="CVarCompare" cvar="aposAcidTick" operation="GT" value="-8"/>
			</triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyStats" stat="Health" operation="add" value="@aposAcidTick"/>
		</effect_group>
	</append>

	<!-- ===================== 1.0: buffs for attribute and perk highlights (progression.xml) ===================== -->
	<append xpath="/buffs">
		<!-- Flurry 5 "Frenzy": +25% attack speed with that perk's weapons for 5 s -->
		<buff name="buffAposFrenzyPerception" name_key="buffAposFrenzyName" description_key="buffAposFrenzyDesc" icon="ui_game_symbol_run" icon_color="255,180,0">
			<stack_type value="replace"/>
			<duration value="5"/>
			<effect_group>
				<requirement name="HoldingItemHasTags" tags="perkFlurryOfPerception"/>
				<passive_effect name="AttacksPerMinute" operation="perc_add" value=".25"/>
			</effect_group>
		</buff>
		<buff name="buffAposFrenzyStrength" name_key="buffAposFrenzyName" description_key="buffAposFrenzyDesc" icon="ui_game_symbol_run" icon_color="255,180,0">
			<stack_type value="replace"/>
			<duration value="5"/>
			<effect_group>
				<requirement name="HoldingItemHasTags" tags="perkFlurryOfStrength"/>
				<passive_effect name="AttacksPerMinute" operation="perc_add" value=".25"/>
			</effect_group>
		</buff>
		<buff name="buffAposFrenzyFortitude" name_key="buffAposFrenzyName" description_key="buffAposFrenzyDesc" icon="ui_game_symbol_run" icon_color="255,180,0">
			<stack_type value="replace"/>
			<duration value="5"/>
			<effect_group>
				<requirement name="HoldingItemHasTags" tags="perkFlurryOfFortitude"/>
				<passive_effect name="AttacksPerMinute" operation="perc_add" value=".25"/>
			</effect_group>
		</buff>
		<buff name="buffAposFrenzyAgility" name_key="buffAposFrenzyName" description_key="buffAposFrenzyDesc" icon="ui_game_symbol_run" icon_color="255,180,0">
			<stack_type value="replace"/>
			<duration value="5"/>
			<effect_group>
				<requirement name="HoldingItemHasTags" tags="perkFlurryOfAgility"/>
				<passive_effect name="AttacksPerMinute" operation="perc_add" value=".25"/>
			</effect_group>
		</buff>

		<!-- Agility 10 "Adrenaline": number = stacks (max 3), +10% move speed each, 15 s after the last kill -->
		<buff name="buffAposAdrenaline" name_key="buffAposAdrenalineName" description_key="buffAposAdrenalineDesc" icon="ui_game_symbol_run" icon_color="0,220,120">
			<stack_type value="ignore"/>
			<display_value value="aposAdrenaline"/>
			<effect_group>
				<passive_effect name="WalkSpeed" operation="perc_add" value="@aposAdrenalineSpeed"/>
				<passive_effect name="RunSpeed" operation="perc_add" value="@aposAdrenalineSpeed"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="aposAdrenalineTime" operation="add" value="-1"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposAdrenaline">
					<requirement name="CVarCompare" cvar="aposAdrenalineTime" operation="LTE" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="aposAdrenaline" operation="set" value="0"/>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="aposAdrenalineSpeed" operation="set" value="0"/>
			</effect_group>
		</buff>

		<!-- Intellect 10 "EMP": number = charges (10 = ready) -->
		<buff name="buffAposEmp" name_key="buffAposEmpName" description_key="buffAposEmpDesc" icon="ui_game_symbol_electric_power" icon_color="80,140,255" remove_on_death="false">
			<stack_type value="ignore"/>
			<display_value value="aposEmp"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAposEmp">
					<requirement name="CVarCompare" cvar="aposEmp" operation="LTE" value="0"/>
				</triggered_effect>
			</effect_group>
		</buff>

		<!-- Mother Lode 5 "Jackpot": x5 harvest for 2 s -->
		<buff name="buffAposJackpot" name_key="buffAposJackpotName" description_key="buffAposJackpotDesc" icon="ui_game_symbol_mining" icon_color="255,210,0">
			<stack_type value="replace"/>
			<duration value="2"/>
			<effect_group>
				<passive_effect name="HarvestCount" operation="perc_add" value="4" tags="oreWoodHarvest"/>
			</effect_group>
		</buff>

		<!-- Agility Mastery 5 "Evasion" -->
		<buff name="buffAposEvasion" name_key="buffAposEvasionName" description_key="buffAposEvasionDesc" icon="ui_game_symbol_run" icon_color="0,200,255">
			<stack_type value="replace"/>
			<duration value="5"/>
			<effect_group>
				<passive_effect name="WalkSpeed" operation="perc_add" value=".3"/>
				<passive_effect name="RunSpeed" operation="perc_add" value=".3"/>
			</effect_group>
		</buff>

		<!-- Fortitude Mastery 5 "Second Wind" cooldown (visible: you know when it is ready again) -->
		<buff name="buffAposSecondWindCD" name_key="buffAposSecondWindName" description_key="buffAposSecondWindDesc" icon="ui_game_symbol_healing_factor" icon_color="150,150,150">
			<stack_type value="ignore"/>
			<duration value="300"/>
		</buff>
		<!-- Rule 1: Cardio 5 "Second Lungs" cooldown -->
		<buff name="buffAposSecondLungsCD" name_key="buffAposSecondLungsName" description_key="buffAposSecondLungsDesc" icon="ui_game_symbol_run" icon_color="150,150,150">
			<stack_type value="ignore"/>
			<duration value="60"/>
		</buff>

		<!-- Healing Factor 5: "in combat" for 10 s after any hit given or taken -->
		<buff name="buffAposInCombat" hidden="true">
			<stack_type value="replace"/>
			<duration value="10"/>
		</buff>
		<buff name="buffAposButcherCD" hidden="true">
			<stack_type value="ignore"/>
			<duration value="5"/>
		</buff>

		<!-- Demolitions Expert 5 "Chain Reaction": explosion look on the killed zombie (damage: Source/AposCombat.cs) -->
		<buff name="buffAposChainBlast" hidden="true">
			<stack_type value="replace"/>
			<duration value=".1"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="Explode" blast_power="0" block_damage="0" block_radius="0" entity_damage="0" entity_radius="0" damage_type="Heat"/>
			</effect_group>
		</buff>
	</append>

	<!-- Charismatic Nature 5 "Leader": the perk owner gets the Charismatic bonuses twice -->
	<append xpath="/buffs/buff[@name='buffPerkCharismaticNature']">
		<effect_group name="AposMod leader">
			<requirement name="ProgressionLevel" progression_name="perkCharismaticNature" operation="GTE" value="5"/>
			<passive_effect name="HealthChangeOT" operation="base_add" value=".5"/>
			<passive_effect name="EntityDamage" operation="perc_add" value=".2"/>
			<passive_effect name="BlockDamage" operation="perc_add" value=".2" tags="melee"/>
			<passive_effect name="GeneralDamageResist" operation="base_add" value=".1"/>
			<passive_effect name="LootStage" operation="perc_add" value=".3"/>
			<passive_effect name="AttributeLevel" operation="base_add" value="1"/>
		</effect_group>
	</append>

	<!-- Fortitude 10 "Iron Body": an infection caught before reaching level 10 is cured -->
	<append xpath="/buffs/buff[@name='buffStatusCheck01']">
		<effect_group name="AposMod iron body cure">
			<requirement name="ProgressionLevel" progression_name="attFortitude" operation="GTE" value="10"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffInfectionMain,buffInfectionGetsWorse,buffInfection01Untreated,buffInfection01GetBetter,buffInfection02Untreated,buffInfection02GetBetter,buffInfection03Untreated,buffInfection03GetBetter,buffInfection04">
				<requirement name="HasBuff" buff="buffInfectionMain,buffInfection01Untreated,buffInfection02Untreated,buffInfection03Untreated,buffInfection04"/>
			</triggered_effect>
		</effect_group>
	</append>
</configs>
