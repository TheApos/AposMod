<configs>
	<!-- ===== Energy Shield (chest armor mod) ===== -->
	<!-- While charged (buffAposShieldUp) ranged attacks deal no damage (PhysicalDamageResist +100 for the "ranged" tag,
	     the same tag vanilla uses for ranged-immune creatures). Any hit drains it; it recharges after 5 s without damage.
	     aposShieldWorn tells buffStatusCheck01 (buffs.xml) that the mod is worn; aposShieldDown is the recharge timer. -->
	<append xpath="/item_modifiers">
		<item_modifier name="modArmorAposEnergyShield" installable_tags="armorChest" modifier_tags="aposShield" blocked_tags="noMods" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modArmorPlatingReinforced"/>
			<property name="CustomIconTint" value="0,200,255"/>
			<property name="TraderStageTemplate" value="modsTier2"/>
			<property name="DisplayType" value="modArmor"/>
			<property name="DescriptionKey" value="modArmorAposEnergyShieldDesc"/>
			<effect_group tiered="false">
				<triggered_effect trigger="onSelfEquipStart" action="ModifyCVar" cvar="aposShieldWorn" operation="set" value="1"/>
				<triggered_effect trigger="onSelfEquipStop" action="ModifyCVar" cvar="aposShieldWorn" operation="set" value="0"/>
				<triggered_effect trigger="onSelfEquipStop" action="RemoveBuff" buff="buffAposShieldUp"/>
				<!-- a hit drains the shield (the hit itself is still absorbed if it was ranged) -->
				<triggered_effect trigger="onOtherDamagedSelf" action="ModifyCVar" cvar="aposShieldWorn" operation="set" value="1"/>
				<triggered_effect trigger="onOtherDamagedSelf" action="ModifyCVar" cvar="aposShieldDown" operation="set" value="5"/>
				<triggered_effect trigger="onOtherDamagedSelf" action="RemoveBuff" buff="buffAposShieldUp"/>
			</effect_group>
		</item_modifier>

		<!-- ===== Elemental weapon mods (one per weapon: shared modifier_tags "aposElement") ===== -->
		<!-- onSelfAttackedOther = every hit with this weapon, the same trigger vanilla fire weapons use -->
		<item_modifier name="modWeaponAposFire" installable_tags="weapon" modifier_tags="aposElement" blocked_tags="noMods,turretRanged,turretMelee" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modMeleeClubBurningShaft"/>
			<property name="CustomIconTint" value="255,110,0"/>
			<property name="TraderStageTemplate" value="modsTier2"/>
			<property name="DescriptionKey" value="modWeaponAposFireDesc"/>
			<effect_group tiered="false">
				<triggered_effect trigger="onSelfAttackedOther" action="AddBuff" target="other" buff="buffBurningElement">
					<requirement name="IsAlive" target="other"/>
					<requirement name="!EntityTagCompare" target="other" tags="trader"/>
					<requirement name="CVarCompare" target="other" cvar="_underwater" operation="LT" value="0.3"/>
					<requirement name="RandomRoll" seed_type="Random" min_max="0,100" operation="LTE" value="30"/>
				</triggered_effect>
			</effect_group>
		</item_modifier>

		<!-- batons (perkElectrocutioner) already shock with every hit, so Tesla is blocked on them -->
		<item_modifier name="modWeaponAposShock" installable_tags="weapon" modifier_tags="aposElement" blocked_tags="noMods,turretRanged,turretMelee,perkElectrocutioner" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modMeleeStunBatonRepulsor"/>
			<property name="CustomIconTint" value="80,170,255"/>
			<property name="TraderStageTemplate" value="modsTier2"/>
			<property name="DescriptionKey" value="modWeaponAposShockDesc"/>
			<effect_group tiered="false">
				<triggered_effect trigger="onSelfAttackedOther" action="AddBuff" target="other" buff="buffShocked" duration="1.5">
					<requirement name="IsAlive" target="other"/>
					<requirement name="!EntityTagCompare" target="other" tags="trader"/>
					<requirement name="RandomRoll" seed_type="Random" min_max="0,100" operation="LTE" value="20"/>
				</triggered_effect>
			</effect_group>
		</item_modifier>

		<item_modifier name="modWeaponAposAcid" installable_tags="weapon" modifier_tags="aposElement" blocked_tags="noMods,turretRanged,turretMelee" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modGunCrippleEm"/>
			<property name="CustomIconTint" value="120,255,60"/>
			<property name="TraderStageTemplate" value="modsTier2"/>
			<property name="DescriptionKey" value="modWeaponAposAcidDesc"/>
			<effect_group tiered="false">
				<triggered_effect trigger="onSelfAttackedOther" action="ModifyCVar" target="other" cvar="aposCorrodeTime" operation="set" value="6">
					<requirement name="IsAlive" target="other"/>
					<requirement name="RandomRoll" seed_type="Random" min_max="0,100" operation="LTE" value="25"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfAttackedOther" action="AddBuff" target="other" buff="buffAposCorroded">
					<requirement name="IsAlive" target="other"/>
					<requirement name="!EntityTagCompare" target="other" tags="trader"/>
					<requirement name="CVarCompare" target="other" cvar="aposCorrodeTime" operation="GT" value="0"/>
				</triggered_effect>
			</effect_group>
		</item_modifier>
	</append>
	<!-- ===== Eridium modules (Source/AposElites.cs): installed like a weapon mod, they change the weapon at once and
	     disappear. Reroll: one random unlocked affix gets a new type and value. Lock: protects the best affix from Reroll.
	     Temper: +1 quality (max 6), affix values grow to the new quality. Not on legendaries (fixed bonuses). ===== -->
	<append xpath="/item_modifiers">
		<item_modifier name="modWeaponAposReroll" installable_tags="weapon" modifier_tags="aposModuleReroll" blocked_tags="noMods,turretRanged,turretMelee,aposLegend" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modGunTriggerGroupAutomatic"/>
			<property name="CustomIconTint" value="190,90,255"/>
			<property name="DescriptionKey" value="modWeaponAposRerollDesc"/>
		</item_modifier>
		<item_modifier name="modWeaponAposLock" installable_tags="weapon" modifier_tags="aposModuleLock" blocked_tags="noMods,turretRanged,turretMelee,aposLegend" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modMeleeStructuralBrace"/>
			<property name="CustomIconTint" value="190,90,255"/>
			<property name="DescriptionKey" value="modWeaponAposLockDesc"/>
		</item_modifier>
		<item_modifier name="modWeaponAposTemper" installable_tags="weapon" modifier_tags="aposModuleTemper" blocked_tags="noMods,turretRanged,turretMelee,aposLegend" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modMeleeTemperedBlade"/>
			<property name="CustomIconTint" value="190,90,255"/>
			<property name="DescriptionKey" value="modWeaponAposTemperDesc"/>
		</item_modifier>
	</append>

	<!-- ===== Burning Shaft: half the vanilla ignite chance (5-30% instead of 10-60%): fire now scales with the hit ===== -->
	<set xpath="/item_modifiers/item_modifier[@name='modMeleeClubBurningShaft']//triggered_effect[@cvar='$burningShaft' and @value='10']/@value">5</set>
	<set xpath="/item_modifiers/item_modifier[@name='modMeleeClubBurningShaft']//triggered_effect[@cvar='$burningShaft' and @value='20']/@value">10</set>
	<set xpath="/item_modifiers/item_modifier[@name='modMeleeClubBurningShaft']//triggered_effect[@cvar='$burningShaft' and @value='30']/@value">15</set>
	<set xpath="/item_modifiers/item_modifier[@name='modMeleeClubBurningShaft']//triggered_effect[@cvar='$burningShaft' and @value='40']/@value">20</set>
	<set xpath="/item_modifiers/item_modifier[@name='modMeleeClubBurningShaft']//triggered_effect[@cvar='$burningShaft' and @value='50']/@value">25</set>
	<set xpath="/item_modifiers/item_modifier[@name='modMeleeClubBurningShaft']//triggered_effect[@cvar='$burningShaft' and @value='60']/@value">30</set>
	<set xpath="/item_modifiers/item_modifier[@name='modMeleeClubBurningShaft']//display_value[@name='dburningShaft']/@value">.05,.1,.15,.2,.25,.3</set>
</configs>