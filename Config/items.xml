<configs>
	<!-- ===== Grenades: x3 radius vs entities, block radius unchanged ===== -->
	<!-- thrownGrenade extends thrownGrenadeContact, but gets its own value to be explicit -->
	<set xpath="/items/item[@name='thrownGrenadeContact']/property[@class='Explosion']/property[@name='RadiusEntities']/@value">15</set>
	<set xpath="/items/item[@name='thrownGrenadeContact']/effect_group/display_value[@name='dExRadius']/@value">7.5</set>
	<append xpath="/items/item[@name='thrownGrenade']/property[@class='Explosion']">
		<property name="RadiusEntities" value="15"/>
	</append>
	<set xpath="/items/item[@name='thrownGrenade']/effect_group/display_value[@name='dExRadius']/@value">4.5</set>
	<set xpath="/items/item[@name='thrownAmmoPipeBomb']/property[@class='Explosion']/property[@name='RadiusEntities']/@value">12</set>
	<set xpath="/items/item[@name='thrownAmmoPipeBomb']/effect_group/display_value[@name='dExRadius']/@value">4.5</set>

	<!-- ===== Molotov: fire puddle lasts twice as long (slow is in buffs.xml) ===== -->
	<set xpath="/items/item[@name='thrownAmmoMolotovCocktail']/property[@class='Explosion']/property[@name='Duration']/@value">16</set>

	<!-- ===== Shotgun slugs: knock the target back and down ===== -->
	<!-- Ammo effects fire together with the weapon's, so buckshot is not affected -->
	<append xpath="/items/item[@name='ammoShotgunSlug' or @name='ammoShotgunBreachingSlug']/effect_group[1]">
		<triggered_effect trigger="onSelfPrimaryActionRayHit" action="Ragdoll" target="other" duration="2.5" force="1000">
			<requirement name="IsAlive" target="other"/>
			<requirement name="!EntityTagCompare" target="other" tags="trader"/>
		</triggered_effect>
	</append>

	<!-- ===== Bows "Splinter": every arrow hurts zombies within 2.5 m of the impact for 10 + 8 HP per Archery level ===== -->
	<!-- On the arrows because only ammo knows the impact point (positionAOE). buffAposSplash ignores a second
	     application, so an effect group inherited through Extends cannot double the damage. -->
	<append xpath="/items/item[starts-with(@name,'ammoArrow')]">
		<effect_group name="AposMod splinter" tiered="false">
			<triggered_effect trigger="onProjectileImpact" action="ModifyCVar" target="positionAOE" range="2.5" target_tags="zombie,animal" cvar="aposSplashDmg" operation="set" value="-10"><requirement name="ProgressionLevel" progression_name="perkArchery" operation="Equals" value="0"/></triggered_effect>
			<triggered_effect trigger="onProjectileImpact" action="ModifyCVar" target="positionAOE" range="2.5" target_tags="zombie,animal" cvar="aposSplashDmg" operation="set" value="-18"><requirement name="ProgressionLevel" progression_name="perkArchery" operation="Equals" value="1"/></triggered_effect>
			<triggered_effect trigger="onProjectileImpact" action="ModifyCVar" target="positionAOE" range="2.5" target_tags="zombie,animal" cvar="aposSplashDmg" operation="set" value="-26"><requirement name="ProgressionLevel" progression_name="perkArchery" operation="Equals" value="2"/></triggered_effect>
			<triggered_effect trigger="onProjectileImpact" action="ModifyCVar" target="positionAOE" range="2.5" target_tags="zombie,animal" cvar="aposSplashDmg" operation="set" value="-34"><requirement name="ProgressionLevel" progression_name="perkArchery" operation="Equals" value="3"/></triggered_effect>
			<triggered_effect trigger="onProjectileImpact" action="ModifyCVar" target="positionAOE" range="2.5" target_tags="zombie,animal" cvar="aposSplashDmg" operation="set" value="-42"><requirement name="ProgressionLevel" progression_name="perkArchery" operation="Equals" value="4"/></triggered_effect>
			<triggered_effect trigger="onProjectileImpact" action="ModifyCVar" target="positionAOE" range="2.5" target_tags="zombie,animal" cvar="aposSplashDmg" operation="set" value="-50"><requirement name="ProgressionLevel" progression_name="perkArchery" operation="Equals" value="5"/></triggered_effect>
			<triggered_effect trigger="onProjectileImpact" action="AddBuff" target="positionAOE" range="2.5" target_tags="zombie,animal" buff="buffAposSplash"/>
			<!-- Archery 5: a headshot arrow sets the target on fire -->
			<triggered_effect trigger="onProjectileImpact" action="AddBuff" target="other" buff="buffBurningFlamingArrow">
				<requirement name="ProgressionLevel" progression_name="perkArchery" operation="Equals" value="5"/>
				<requirement name="HitLocation" body_parts="Head"/>
				<requirement name="CVarCompare" target="other" cvar="_underwater" operation="LT" value="0.3"/>
			</triggered_effect>
		</effect_group>
	</append>

	<!-- ===== Crossbows "Mark": a bolt marks the zombie for 10 s (bonus damage in entityclasses.xml) ===== -->
	<append xpath="/items/item[starts-with(@name,'ammoCrossbowBolt')]">
		<effect_group name="AposMod mark" tiered="false">
			<triggered_effect trigger="onProjectileImpact" action="ModifyCVar" target="other" cvar="aposMarkTime" operation="set" value="10"/>
			<triggered_effect trigger="onProjectileImpact" action="AddBuff" target="other" buff="buffAposMark">
				<requirement name="!EntityTagCompare" target="other" tags="trader"/>
			</triggered_effect>
		</effect_group>
	</append>

	<!-- ===== Pipe weapons (T0): tag for the "veteran" bonus, repair with scrap iron ===== -->
	<csv xpath="/items/item[@name='gunHandgunT0PipePistol' or @name='gunShotgunT0PipeShotgun' or @name='gunRifleT0PipeRifle' or @name='gunMGT0PipeMachineGun' or @name='meleeWpnBatonT0PipeBaton']/property[@name='Tags']/@value" delim="," op="add">aposPipe</csv>
	<set xpath="/items/item[@name='gunHandgunT0PipePistol' or @name='gunShotgunT0PipeShotgun' or @name='gunRifleT0PipeRifle' or @name='gunMGT0PipeMachineGun' or @name='meleeWpnBatonT0PipeBaton']/property[@name='RepairTools']/@value">resourceScrapIron</set>

	<!-- ===== Intellect Mastery 4-5 no longer boost the stun baton (replaced in progression.xml) ===== -->
	<!-- level 4: charge in 2 hits; level 5: sets perkIntelMaster5, which buffShocked turns into +300% shock damage -->
	<remove xpath="/items/item[@name='meleeWpnBatonT2StunBaton']//triggered_effect[requirement[@progression_name='perkIntellectMastery' and (@value='4' or @value='5')]]"/>

	<!-- ===== Rocket launcher: available at traders from the start ===== -->
	<set xpath="/items/item[@name='gunExplosivesT3RocketLauncher']/property[@name='TraderStageTemplate']/@value">baseTier1</set>

