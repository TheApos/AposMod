<configs>
	<!-- ===== Rocket launcher in early-game explosive loot (launcher + 1 rocket) ===== -->
	<!-- A lootgroup must be defined before it is referenced, so the new group goes right above its user -->
	<insertBefore xpath="/lootcontainers/lootgroup[@name='groupWeaponsT1_Demolitionist']">
		<lootgroup name="groupAposEarlyRocketLauncher" count="all" loot_quality_template="QLTemplateT1">
			<item name="gunExplosivesT3RocketLauncher"/>
			<item group="groupAmmoRocket"/>
		</lootgroup>
	</insertBefore>
	<append xpath="/lootcontainers/lootgroup[@name='groupWeaponsT1_Demolitionist']">
		<item group="groupAposEarlyRocketLauncher" prob="0.15"/>
	</append>

	<!-- ===== Energy Shield armor mod can drop where other tier 3 armor mods drop ===== -->
	<append xpath="/lootcontainers/lootgroup[@name='modArmorT3']">
		<item name="modArmorAposEnergyShield"/>
	</append>

	<!-- ===== Legendary weapons: rare drop from tier 4 (4%) and tier 5 (10%) final chests, always quality 6 ===== -->
	<append xpath="/lootcontainers/lootqualitytemplates[1]">
		<lootqualitytemplate name="QLTemplateApos6">
			<qualitytemplate level="0,999999" default_quality="6">
				<loot quality="6" prob="1"/>
			</qualitytemplate>
		</lootqualitytemplate>
		<lootqualitytemplate name="QLTemplateApos56">
			<qualitytemplate level="0,999999" default_quality="5">
				<loot quality="5" prob=".6"/>
				<loot quality="6" prob="1"/>
			</qualitytemplate>
		</lootqualitytemplate>
	</append>

	<!-- ===== Treasure Hunter 5 "X Marks the Spot": buried treasure also holds a quality 5-6 weapon (with affixes).
	     prob 0 + tag: only the perk's LootProb base_set (progression.xml) turns it on, like vanilla Master Chef 2. ===== -->
	<insertBefore xpath="/lootcontainers/lootgroup[@name='groupBuriedTreasure']">
		<lootgroup name="groupAposTreasureWeapon" count="1" loot_quality_template="QLTemplateApos56">
			<item name="gunHandgunT3DesertVulture"/>
			<item name="gunHandgunT3SMG5"/>
			<item name="gunShotgunT3AutoShotgun"/>
			<item name="gunShotgunT2PumpShotgun"/>
			<item name="gunRifleT3SniperRifle"/>
			<item name="gunRifleT2LeverActionRifle"/>
			<item name="gunMGT3M60"/>
			<item name="gunMGT2TacticalAR"/>
			<item name="gunBowT3CompoundBow"/>
			<item name="gunBowT3CompoundCrossbow"/>
			<item name="meleeWpnBladeT3Machete"/>
			<item name="meleeWpnClubT3SteelClub"/>
			<item name="meleeWpnSledgeT3SteelSledgehammer"/>
			<item name="meleeWpnSpearT3SteelSpear"/>
			<item name="meleeWpnKnucklesT3SteelKnuckles"/>
			<item name="meleeWpnBatonT2StunBaton"/>
		</lootgroup>
	</insertBefore>
	<append xpath="/lootcontainers/lootgroup[@name='groupBuriedTreasure']">
		<item group="groupAposTreasureWeapon" prob="0" tags="aposTreasureHunter5"/>
	</append>
	<insertBefore xpath="/lootcontainers/lootgroup[@name='groupHardenedChestT4']">
		<lootgroup name="groupAposLegendary" loot_quality_template="QLTemplateApos6">
			<item name="aposLegendHarold"/>
			<item name="aposLegendLadyFist"/>
			<item name="aposLegendDragonBreath"/>
			<item name="aposLegendRipper"/>
			<item name="aposLegendThunderclap"/>
			<item name="aposLegendHornet"/>
			<item name="aposLegendStormFist"/>
			<item name="aposLegendArtemis"/>
			<item name="aposLegendBigBoom"/>
			<item name="aposLegendPredator"/>
		</lootgroup>
	</insertBefore>
	<append xpath="/lootcontainers/lootgroup[@name='groupHardenedChestT4']">
		<item group="groupAposLegendary" prob="0.04"/>
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupHardenedChestT5']">
		<item group="groupAposLegendary" prob="0.1"/>
	</append>

	<!-- ===== Final POI chests always contain rockets, more for harder POIs ===== -->
	<!-- Chest tier matches POI difficulty: T1 leather trunk ... T5 hardened chest -->
	<append xpath="/lootcontainers/lootgroup[@name='groupReinforcedChestT1']">
		<item group="groupAmmoRocket" count="1"/>
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupReinforcedChestT2']">
		<item group="groupAmmoRocket" count="1,2"/>
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupReinforcedChestT3']">
		<item group="groupAmmoRocket" count="2,3"/>
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupHardenedChestT4']">
		<item group="groupAmmoRocket" count="3,4"/>
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupHardenedChestT5']">
		<item group="groupAmmoRocket" count="4,6"/>
	</append>
</configs>
